<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ButtonTextAppearance">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">40sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:fontFamily">monospace</item>
        <item name="autoSizeMaxTextSize">20sp</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="android:textAlignment">center</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeStepGranularity">2sp</item>
        <item name="backgroundTint">@null</item>


    </style>

    <style name="LargeTextViewAppearance">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">40sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:fontFamily">monospace</item>
        <item name="autoSizeMaxTextSize">70sp</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeStepGranularity">2sp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textAlignment">center</item>



    </style>
</resources>