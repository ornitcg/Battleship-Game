<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lightBlue"
    app:cardCornerRadius="10dp">

<RelativeLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"> <!-- Ensure RelativeLayout wraps content -->

    <TextView
        android:id="@+id/userNameViewId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="28dp"
        android:text="@string/room_card_user_name"
        android:textColor="@color/black"
        android:textSize="25sp"
        android:layout_centerVertical="true"
        android:textStyle="bold|italic" />

    <ImageView
        android:id="@+id/enterRoomIconId"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/enter_room_arrow" />

</RelativeLayout>
    </androidx.cardview.widget.CardView>
