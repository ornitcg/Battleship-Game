<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sea_water_background">


    <include layout="@layout/item_button_toggle_music" />


    <TextView
        android:id="@+id/turnTextViewId"
        android:layout_width="0dp"
        android:layout_height="59dp"
        android:layout_marginTop="68dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold|italic"
        android:text="@string/your_turn"
        app:autoSizeMaxTextSize="50sp"
        app:autoSizeMinTextSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <GridView
        android:id="@+id/currPlayerBoardGridId"
        android:layout_width="0dp"
        android:layout_height="297dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/sea_water_background"
        android:gravity="center"
        android:numColumns="10"
        android:stretchMode="columnWidth"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/turnTextViewId"
         />

    <GridView
        android:id="@+id/opponentBoardGridId"
        android:layout_width="0dp"
        android:layout_height="262dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/sea_water_background"
        android:gravity="center"
        android:numColumns="10"
        android:stretchMode="columnWidth"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>