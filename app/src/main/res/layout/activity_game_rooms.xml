<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dark_sea"
    tools:context=".view.activities.GameRooms">


        <include
            layout="@layout/item_button_toggle_music"
            tools:layout_editor_absoluteX="-16dp"
            tools:layout_editor_absoluteY="0dp" />

        <TextView
            android:id="@+id/titleViewId"
            style="@style/LargeTextViewAppearance"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_marginTop="76dp"
            android:layout_marginHorizontal="10dp"
            android:textSize="20sp"
            android:autoSizeMaxTextSize="30dp"
            android:text="@string/rooms_activity_title"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/roomsRecyclerViewId"
            android:layout_width="358dp"
            android:layout_height="571dp"
            app:layout_constraintBottom_toTopOf="@+id/createNewRoomBtnId"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleViewId" />

        <Button
            android:id="@+id/createNewRoomBtnId"
            style="@style/ButtonTextAppearance"
            android:background="@drawable/custom_navigation_button_background"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginBottom="64dp"
            android:text="CREATE NEW ROOM"
            android:onClick="goToPlaceYourShips"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.504"
            app:layout_constraintStart_toStartOf="parent"
             />




</androidx.constraintlayout.widget.ConstraintLayout>