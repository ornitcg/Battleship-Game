<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameRooms">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameRommsLayoutId"
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:background="@drawable/dark_sea"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <TextView
            android:id="@+id/titleViewId"
            android:layout_width="346dp"
            android:layout_height="75dp"
            android:layout_marginTop="52dp"
            android:fontFamily="monospace"
            android:text="PLAY ROOMS"
            android:textColor="@color/white"
            android:textSize="50sp"
            android:textStyle="bold|italic"
            app:autoSizeMaxTextSize="70sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/createNewRoomBtnId"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/navy"
            android:cursorVisible="false"
            android:fontFamily="monospace"
            android:text="CREATE NEW ROOM"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            app:cornerRadius="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollView3"
            app:strokeColor="#0C0C75"
            app:strokeWidth="3dp" />

        <ScrollView
            android:id="@+id/scrollView3"
            android:layout_width="409dp"
            android:layout_height="507dp"
            tools:layout_editor_absoluteX="1dp"
            tools:layout_editor_absoluteY="128dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>