<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/sea_water_background"
tools:context=".view.activities.OptionsActivity">



        <TextView
            android:id="@+id/titleViewId"
            style="@style/LargeTextViewAppearance"
            android:layout_width="346dp"
            android:layout_height="75dp"
            android:layout_marginTop="52dp"
            android:text="WHAT WOULD YOU LIKE TO DO?"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <Button
            android:id="@+id/startPlayinhBtnId"
            style="@style/ButtonTextAppearance"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginBottom="84dp"
            android:background="@drawable/custom_navigation_button_background"
            android:onClick="goToGameRooms"
            android:text="START PLAYING"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.242" />

        <Button
            android:id="@+id/goToLeaderboardBtnId"
            style="@style/ButtonTextAppearance"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/custom_navigation_button_background"
            android:text="WATCH LEADERBOARD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/startPlayinhBtnId"
            />

        <Button
            android:id="@+id/watchProfileId"
            style="@style/ButtonTextAppearance"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/custom_navigation_button_background"
            android:text="WATCH PROFILE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goToLeaderboardBtnId"
             />

        <Button
            android:id="@+id/quitBtnId"
            style="@style/ButtonTextAppearance"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/custom_navigation_button_background"
            android:text="QUIT"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/watchProfileId"
             />

</androidx.constraintlayout.widget.ConstraintLayout>