<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/sea_water_background"
tools:context=".view.OptionsActivity">



        <TextView
            android:id="@+id/titleViewId"
            android:layout_width="346dp"
            android:layout_height="75dp"
            android:layout_marginTop="52dp"
            android:fontFamily="monospace"
            android:text="WHAT WOULD YOU LIKE TO DO?"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="50sp"
            android:textStyle="bold|italic"
            app:autoSizeMaxTextSize="70sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/startPlayinhBtnId"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginTop="52dp"
            android:backgroundTint="@color/navy"
            android:cursorVisible="false"
            android:fontFamily="monospace"
            android:onClick="goToGameRooms"
            android:text="START PLAYING"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:cornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleViewId"
            app:strokeColor="#0C0C75"
            app:strokeWidth="3dp" />

        <Button
            android:id="@+id/goToLeaderboardBtnId"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/navy"
            android:cursorVisible="false"
            android:fontFamily="monospace"
            android:text="WATCH LEADERBOARD"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:cornerRadius="20dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/startPlayinhBtnId"
            app:strokeColor="#0C0C75"
            app:strokeWidth="3dp" />

        <Button
            android:id="@+id/watchProfileId"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/navy"
            android:cursorVisible="false"
            android:fontFamily="monospace"
            android:text="WATCH PROFILE"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:cornerRadius="20dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goToLeaderboardBtnId"
            app:strokeColor="#0C0C75"
            app:strokeWidth="3dp" />

        <Button
            android:id="@+id/quitBtnId"
            android:layout_width="295dp"
            android:layout_height="59dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/navy"
            android:cursorVisible="false"
            android:fontFamily="monospace"
            android:text="QUIT"
            android:textColor="@color/white"
            android:textSize="20sp"

            android:textStyle="bold|italic"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:cornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/watchProfileId"
            app:strokeColor="#0C0C75"
            app:strokeWidth="3dp" />

</androidx.constraintlayout.widget.ConstraintLayout>