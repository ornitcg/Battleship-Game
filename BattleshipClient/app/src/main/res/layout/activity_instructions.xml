<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainInstructions"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_instructions"
    tools:context=".view.activities.InstructionsActivity">

    <include layout="@layout/base_layout" />

    <TextView
        android:id="@+id/instructionTitleId"
        android:layout_width="297dp"
        android:layout_height="73dp"
        android:layout_marginTop="56dp"
        android:gravity="center_horizontal"
        android:text="INSTRUCTIONS"
        android:textAppearance="@style/MediumWhiteTextViewAppearance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="413dp"
        android:layout_height="761dp"
        android:layout_marginTop="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/instructionTitleId">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/instructionsTextId1"
                android:layout_width="377dp"
                android:layout_height="match_parent"
                android:gravity="left"

                android:text="@string/instructions1"
                android:textAppearance="@style/SmallTextAppearance" />

            <LinearLayout
                android:id="@+id/visualExplanationId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/placementExamplesTitleId"
                    style="@style/SmallTextAppearance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Placements examples:" />


                <LinearLayout
                    android:id="@+id/visualExplanationTitlesId"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/legalPlacementTitleId"
                        style="@style/SmallTextAppearance"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="OK" />

                    <TextView
                        android:id="@+id/illegalPlacementTitleId"
                        style="@style/SmallTextAppearance"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="WRONG" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/visualExplanationImagesId"

                    android:layout_width="match_parent"
                    android:layout_height="200dp"

                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/visualExplanationTitlesId">

                    <ImageView
                        android:id="@+id/legalPlacementImageId"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/instructions_legal_placement" />

                    <ImageView
                        android:id="@+id/illegalPlacementImageId"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/instructions_illegal_placement" />


                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/instructionsTextId2"
                android:layout_width="377dp"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:gravity="left"
                android:text="@string/instructions2"
                android:textAppearance="@style/SmallTextAppearance" />


        </LinearLayout>


    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>