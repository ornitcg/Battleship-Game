<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/yesNoLayoutId"
        android:layout_width="351dp"
        android:layout_height="181dp"
        android:background="@drawable/background_message"
        android:visibility="gone"
        app:circularflow_defaultRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.499">

        <TextView
            android:id="@+id/questionTextId"
            android:layout_width="267dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:text="Exit?"
            android:textAlignment="center"
            android:textAppearance="@style/DarkLargeTextViewAppearance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/yesButtonId"
            style="@style/LargeTextViewAppearance"
            strokeColor="@color/navy"
            android:layout_width="94dp"
            android:layout_height="60dp"
            android:layout_marginStart="72dp"
            android:layout_marginTop="20dp"
            android:background="@color/white"
            android:text="YES"
            android:textAppearance="@style/DarkLargeTextViewAppearance"
            android:textColor="@color/navy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/questionTextId" />

        <Button
            android:id="@+id/noButtonId"
            style="@style/LargeTextViewAppearance"
            android:layout_width="94dp"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="64dp"
            android:background="@color/navy"
            android:text="NO"
            android:textAppearance="@style/LargeTextViewAppearance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/questionTextId" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>