<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sea_water_background">

    <include layout="@layout/item_button_toggle_music" />

    <TextView
        android:id="@+id/turnTextViewId"
        android:layout_width="0dp"
        android:layout_height="59dp"
        android:layout_marginTop="36dp"
        android:text="@string/your_turn"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold|italic"
        app:autoSizeMaxTextSize="50sp"
        app:autoSizeMinTextSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridView
        android:id="@+id/opponentBoardGridId"
        android:layout_width="0dp"
        android:layout_height="317dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/sea_water_background"
        android:gravity="center"
        android:numColumns="10"
        android:stretchMode="columnWidth"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/turnTextViewId" />

    <FrameLayout
        android:id="@+id/shipsOpponentFrameLayoutId"
        android:layout_width="0dp"
        android:layout_height="317dp"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="12dp"
        android:gravity="center"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/turnTextViewId">

        <ImageView
            android:id="@+id/ship5_opponent_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length5"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/ship4_opponent_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length4"
            android:visibility="invisible"/>

        <ImageView
            android:id="@+id/ship3_1_opponent_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length3_1"
            android:visibility="invisible"/>


        <ImageView
            android:id="@+id/ship3_2_opponent_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length3_2"
            android:visibility="invisible"/>

        <ImageView
            android:id="@+id/ship_length2_opponent_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length2"
            android:visibility="visible"/>
    </FrameLayout>

    <GridView
        android:id="@+id/currPlayerBoardGridId"
        android:layout_width="0dp"
        android:layout_height="262dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/sea_water_background"
        android:gravity="center"
        android:numColumns="10"
        android:stretchMode="columnWidth"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/opponentBoardGridId"
        app:layout_constraintVertical_bias="0.577" />

    <FrameLayout
        android:id="@+id/shipsCurrPlayerFrameLayoutId"
        android:layout_width="0dp"
        android:layout_height="262dp"
        android:layout_marginBottom="72dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/opponentBoardGridId"
        app:layout_constraintVertical_bias="0.577">

        <ImageView
            android:id="@+id/ship5_currPlayer_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length5"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/ship4_currPlayer_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length4"
            android:visibility="invisible"/>

        <ImageView
            android:id="@+id/ship3_1_currPlayer_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length3_1"
            android:visibility="invisible"/>


        <ImageView
            android:id="@+id/ship3_2_currPlayer_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length3_2"
            android:visibility="invisible"/>

        <ImageView
            android:id="@+id/ship2_currPlayer_id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ship_length2"
            android:visibility="visible"/>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>