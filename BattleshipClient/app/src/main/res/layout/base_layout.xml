<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/baseMainId"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".view.activities.BaseActivity">

    <ImageButton
        android:id="@+id/toggleMusicBtnId"
        android:layout_width="34dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_music_on" />

    <ImageButton
        android:id="@+id/toggleSoundsBtnId"
        android:layout_width="34dp"
        android:layout_height="32dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_sounds_on" />

    <ImageButton
        android:id="@+id/XbuttonId"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="355dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icons8_close_50" />




</androidx.constraintlayout.widget.ConstraintLayout>